{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/:bot([A-Za-z0-9_]{5,32})/:payload([A-Za-z0-9_-]{1,64})", "destination": "/index.html" },
    { "source": "/:payload([A-Za-z0-9_-]{1,64})", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'unsafe-inline'; style-src 'unsafe-inline'; img-src data:; base-uri 'none'; form-action 'none'" }
      ]
    }
  ]
}
